# Rename this file to .env and replace every value before starting Compose.
# Use hex strings to avoid URL-encoding issues in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-64-hex-characters
JWT_SECRET=replace-with-a-different-random-64-hex-characters
HDUHELP_ADMIN_USERNAME=moderator
HDUHELP_ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-16-characters
COOKIE_SECURE=false
